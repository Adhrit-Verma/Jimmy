# Captured data never leaves this machine.
# Neither do API keys (D44: .env holds OPENAI_API_KEY / NVIDIA_API_KEY).
.env
data/
*.db
*.db-wal
*.db-shm

.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Overlay build output and packages (rebuilt with npm install && npm run build)
overlay/node_modules/
overlay/dist/
*.png
!docs/img/*.png
